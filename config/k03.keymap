#include "keys_ru.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        enc_vol: enc_vol {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENC_VOL";
            #sensor-binding-cells = <0>;
            bindings = <&kp C_VOL_UP>, <&kp C_VOL_DN>;
        };

        longPress: longPress {
            compatible = "zmk,behavior-hold-tap";
            label = "LONGPRESS";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <350>;
            flavor = "tap-preferred";
        };

        scrl_rot: scrl_rot {
            compatible = "zmk,behavior-sensor-rotate";
            label = "SCRL_ROT";
            #sensor-binding-cells = <0>;
            bindings = <&kp UP>, <&kp DOWN>;
        };

        HMShiftR: HMShiftR {
            compatible = "zmk,behavior-hold-tap";
            label = "HMSHIFTR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 42 50 51 52 53 54>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
        };

        HMShiftL: HMShiftL {
            compatible = "zmk,behavior-hold-tap";
            label = "HMSHIFTL";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 43 44 45 46 47 48 49 55 56 57 58 59>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
        };

        HMR: HMR {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 42 50 51 52 53 54>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            quick-tap-ms = <175>;
        };

        HML: HML {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 43 44 45 46 47 48 49 55 56 57 58 59>;
            flavor = "balanced";
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
        };
    };

    macros {
        kurs: kurs {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(G) &kp R &kp E &kp E &kp N &kp A &kp T &kp O &kp M &kp N2 &kp N0 &kp N2 &kp N0 &kp ENTER>;
            label = "KURS";
        };

        my_base: my_base {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(G) &kp H &kp B &kp D &kp T &kp N &kp C &kp T &kp V &kp M &kp T &kp N3 &kp N2 &kp N1 &kp ENTER>;
            label = "MY_BASE";
        };

        in_kurs: in_kurs {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(C) &kp I &kp R &kp C &kp L &kp E &kp N1 &kp MINUS &kp LS(W) &kp I &kp N &kp G &kp MINUS &kp LS(R) &kp A &kp N>;
            label = "IN_KURS";
        };

        numbers_key: numbers_key {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp N5 &kp N5 &kp N5 &kp N9 &kp N6 &kp N2 &kp N0 &kp RET>;
            label = "NUMBERS_KEY";
        };
    };

    combos {
        compatible = "zmk,combos";

        LEFT_SQ_BRACK {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <17 16>;
        };

        RIGHT_SQ_BRACK {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <18 19>;
        };

        L_BRACE {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <29 28>;
        };

        R_BRACE {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <30 31>;
        };

        L_PRAT {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <41 40>;
        };

        R_PRAT {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <44 45>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&kp ESC    &mt LS(N1) N1  &mt LS(N2) N2  &mt LS(N3) N3       &mt LS(N4) N4       &mt LS(N5) N5                                                  &mt LS(N6) N6  &mt LS(N7) N7               &mt LS(N8) N8  &mt LS(N9) N9  &mt LS(N0) N0  &kp BACKSPACE
&kp TAB    &kp Q          &kp W          &kp E               &kp R               &longPress GRAVE T                                             &kp Y          &kp U                       &kp I          &kp O          &kp P          &kp LBKT
&kp TAB    &kp A          &kp S          &kp D               &kp F               &kp G                                                          &kp H          &kp J                       &kp K          &kp L          &kp SEMI       &kp SQT
&kp LSHFT  &kp Z          &kp X          &longPress LC(C) C  &longPress LG(V) V  &kp B               &kp LS(BACKSPACE)    &kp LS(LEFT_CONTROL)  &kp N          &longPress RIGHT_BRACKET M  &kp COMMA      &kp DOT        &kp FSLH       &kp RSHFT
                          &kp LGUI       &none               &kp LCTRL           &mo 1               &kp SPACE            &kp ENTER             &mo 2          &kp RIGHT_ALT               &none          &kp RA(SLASH)
            >;

            display-name = "Base";
            sensor-bindings =
                <&enc_vol>,
                <&enc_vol>,
                <&enc_vol>,
                <&enc_vol>,
                <&enc_vol>,
                <&enc_vol>;
        };

        nav {
            bindings = <
&kp F1       &kp F2  &kp F3                           &kp F4    &kp F5                             &kp F6                                      &kp F7           &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&kp LS(F12)  &kp F5  &kp F6                           &kp UP    &kp F7                             &kp LC(Y)                                   &kp PG_UP        &kp N7  &kp N8  &kp N9   &trans   &trans
&kp LS(F7)   &trans  &kp LEFT                         &kp DOWN  &kp RIGHT                          &kp LS(LEFT_ALT)                            &kp PG_DN        &kp N4  &kp N5  &kp N6   &trans   &mkp MB1
&trans       &trans  &mt LC(LG(LEFT_ARROW)) LC(LEFT)  &kp CAPS  &mt LC(LG(RIGHT)) LC(RIGHT_ARROW)  &kp DEL           &kp LS(F1)    &kp LC(F3)  &kp PRINTSCREEN  &kp N1  &kp N2  &kp N3   &trans   &trans
                     &trans                           &trans    &trans                             &trans            &trans        &trans      &mo 3            &trans  &kp N0  &kp DOT
            >;

            display-name = "Nav";
        };

        sym {
            bindings = <
&trans  &trans    &kp AT    &kp DLLR   &kp HASH  &kp RA(N7)                          &trans     &trans    &kp CARET  &trans    &trans    &trans
&trans  &trans    &kp LT    &kp EQUAL  &kp GT    &kp GRAVE                           &trans     &kp LBKT  &kp UNDER  &kp RBKT  &trans    &kp C_PLAY_PAUSE
&trans  &kp BSLH  &kp LPAR  &kp MINUS  &kp RPAR  &kp PLUS                            &kp PRCNT  &kp LBRC  &kp SEMI   &kp RBRC  &kp EXCL  &trans
&trans  &trans    &kp STAR  &kp COLON  &kp FSLH  &trans      &trans    &numbers_key  &trans     &kp PIPE  &kp TILDE  &kp AMPS  &trans    &trans
                  &trans    &trans     &trans    &mo 3       &trans    &trans        &trans     &trans    &trans     &trans
            >;

            display-name = "Symbols";
        };

        adj {
            bindings = <
&bootloader  &trans  &trans  &trans  &trans  &in_kurs                      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2      &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR_ALL
&trans       &trans  &trans  &trans  &trans  &trans                        &trans        &trans        &trans            &trans        &trans        &studio_unlock
&trans       &trans  &trans  &trans  &trans  &trans                        &out OUT_BLE  &kp C_VOL_DN  &kp C_MUTE        &kp C_VOL_UP  &trans        &trans
&trans       &trans  &trans  &trans  &trans  &trans    &kurs     &my_base  &out OUT_USB  &kp C_PREV    &kp C_PLAY_PAUSE  &kp C_NEXT    &trans        &kp INS
                     &trans  &trans  &trans  &trans    &trans    &trans    &trans        &trans        &trans            &to 4
            >;

            display-name = "Adjust";
        };

        Game {
            display-name = "Game";
            bindings = <
&kp ESC    &kp N1  &kp N2    &kp N3  &kp N4     &kp N5                                     &kp N6  &kp N7         &kp N8     &kp N9   &kp N0    &kp BACKSPACE
&kp ESC    &kp Q   &kp W     &kp E   &kp R      &kp T                                      &kp Y   &kp U          &kp I      &kp O    &kp P     &kp LEFT_BRACKET
&kp TAB    &kp A   &kp S     &kp D   &kp F      &kp G                                      &kp H   &kp J          &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT  &kp Z   &kp X     &kp C   &kp V      &kp B   &kp LS(LCTRL)    &kp C_PLAY_PAUSE  &kp N   &kp M          &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                   &kp LGUI  &trans  &kp LCTRL  &mo 5   &kp SPACE        &kp ENTER         &mo 2   &kp RIGHT_ALT  &trans     &to 0
            >;

            sensor-bindings =
                <&enc_vol>,
                <&scrl_rot>,
                <&enc_vol>,
                <&scrl_rot>,
                <&enc_vol>,
                <&scrl_rot>;
        };

        Game_mo1 {
            bindings = <
&trans  &trans    &trans    &trans     &trans  &trans                     &trans  &trans  &trans  &trans   &trans  &trans
&trans  &trans    &kp UP    &trans     &trans  &trans                     &trans  &kp N7  &kp N8  &kp N9   &trans  &trans
&trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans  &trans                     &trans  &kp N4  &kp N5  &kp N6   &trans  &trans
&trans  &trans    &trans    &trans     &trans  &kp DEL  &trans    &trans  &trans  &kp N1  &kp N2  &kp N3   &trans  &trans
                  &trans    &trans     &trans  &trans   &trans    &trans  &trans  &trans  &kp N0  &kp DOT
            >;

            label = "GAjust";
        };
    };
};
